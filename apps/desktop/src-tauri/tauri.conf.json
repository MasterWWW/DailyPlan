{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DailyPlan",
  "version": "0.1.0",
  "identifier": "com.dailyplan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DailyPlan",
        "width": 432,
        "height": 680,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "visible": true,
        "acceptFirstMouse": true
      },
      {
        "label": "sticky",
        "title": "DailyPlan 便签",
        "url": "index.html?view=sticky",
        "width": 300,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "随手记下，稍后完成",
    "longDescription": "DailyPlan 是离线优先的个人每日工作计划工具，支持快速记录、桌面清单、截图、录音和公司内网同步。",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {}
}

