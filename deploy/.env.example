# Copy to .env before running docker compose. Generate both secrets with:
#   openssl rand -hex 32
DAILYPLAN_API_TOKEN=replace-with-generated-token
MYSQL_PASSWORD=replace-with-generated-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password
DAILYPLAN_DATASET_ID=office-default
DAILYPLAN_PORT=8787
DAILYPLAN_READ_ONLY=false
DAILYPLAN_MAX_UPLOAD_BYTES=104857600
WHISPER_MODEL_FILE=ggml-base.bin
WHISPER_LANGUAGE=zh
WHISPER_MODEL_VERSION=whisper-base
DAILYPLAN_WHISPER_TIMEOUT=15m

